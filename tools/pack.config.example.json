{
  "packName": "우리 서버 모드팩",
  "github": "내아이디/modpack",
  "server": {
    "address": "play.example.com",
    "port": 25565
  },
  "memory": {
    "recommendedMB": 6144
  },
  "include": [
    "mods",
    "config",
    "defaultconfigs",
    "kubejs",
    "scripts",
    "resourcepacks",
    "shaderpacks",
    "options.txt",
    "servers.dat"
  ],
  "exclude": [
    "**/*.disabled",
    "**/.DS_Store",
    "**/Thumbs.db",
    "config/**/*.bak"
  ],
  "once": [
    "options.txt",
    "servers.dat"
  ],
  "strictDirs": [
    "mods"
  ]
}
